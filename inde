<a class="wa-float" href="#" data-wa-link rel="noopener" aria-label="گفتگو در واتساپ">
  <svg class="ic" aria-hidden="true"><use href="#i-chat"/></svg><span>واتساپ</span>
</a>

<script>
(function () {
  var root = document.documentElement;
  root.classList.add('js');

  // شماره‌ی واتساپ فروشگاه را فقط همین‌جا تغییر دهید (با کد کشور، بدون +)
  var WA = '989120000000';
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var fine = window.matchMedia('(pointer: fine)').matches;

  document.querySelectorAll('[data-wa-link]').forEach(function (a) {
    a.href = 'https://wa.me/' + WA;
    a.target = '_blank';
  });

  // منوی موبایل
  var header = document.querySelector('.site-header');
  var menuBtn = document.querySelector('.menu-btn');
  function setMenu(open) {
    header.classList.toggle('open', open);
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'بستن منو' : 'باز کردن منو');
  }
  menuBtn.addEventListener('click', function () { setMenu(!header.classList.contains('open')); });
  document.querySelectorAll('.nav a').forEach(function (a) {
    a.addEventListener('click', function () { setMenu(false); });
  });

  // هدر و نوار پیشرفت هنگام اسکرول
  var progress = document.querySelector('.progress');
  function onScroll() {
    var y = window.scrollY;
    header.classList.toggle('scrolled', y > 20);
    var max = document.documentElement.scrollHeight - window.innerHeight;
    progress.style.width = (max > 0 ? (y / max) * 100 : 0) + '%';
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // فیلتر قطعات: برند + جستجوی متنی
  var chips = document.querySelectorAll('.chip');
  var parts = document.querySelectorAll('.part');
  var search = document.getElementById('part-search');
  var activeBrand = 'all';
  function applyFilter() {
    var q = search.value.trim().toLowerCase();
    parts.forEach(function (p) {
      var brandOk = activeBrand === 'all' || p.getAttribute('data-brand') === activeBrand;
      var textOk = q === '' || p.textContent.toLowerCase().indexOf(q) !== -1;
      p.hidden = !(brandOk && textOk);
    });
  }
  chips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      activeBrand = chip.getAttribute('data-filter');
      chips.forEach(function (c) { c.setAttribute('aria-pressed', String(c === chip)); });
      applyFilter();
    });
  });
  search.addEventListener('input', applyFilter);

  // ارسال فرم: پیام با اطلاعات فرستنده در واتساپ آماده می‌شود
  var form = document.getElementById('wa-form');
  form.addEventListener('submit', function (ev) {
    ev.preventDefault();
    if (!form.reportValidity()) return;
    var v = function (n) { return form.elements[n].value.trim(); };
    var text = 'سلام، من ' + v('name') + ' هستم.\nشماره‌ی تماس: ' + v('phone') + '\n' + v('message');
    window.open('https://wa.me/' + WA + '?text=' + encodeURIComponent(text), '_blank', 'noopener');
  });

  // ورود تدریجی المان‌ها با تاخیر پلکانی برای فرزندان گرید و خط زمان
  document.querySelectorAll('.grid-3, .timeline').forEach(function (group) {
    Array.prototype.forEach.call(group.children, function (child, i) {
      child.classList.add('reveal');
      child.style.setProperty('--d', (i * 120) + 'ms');
    });
  });
  var items = document.querySelectorAll('.reveal');
  var timeline = document.querySelector('.timeline');

  function show(el) {
    el.classList.add('in');
    if (el.classList.contains('timeline')) el.classList.add('in');
  }

  if (reduce || !('IntersectionObserver' in window)) {
    items.forEach(show);
    if (timeline) timeline.classList.add('in');
  } else {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (en.isIntersecting) {
          show(en.target);
          io.unobserve(en.target);
        }
      });
    }, { threshold: 0.15 });
    items.forEach(function (el) { io.observe(el); });
    if (timeline) {
      var tio = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) { timeline.classList.add('in'); tio.disconnect(); }
        });
      }, { threshold: 0.3 });
      tio.observe(timeline);
    }
  }

  // اعداد با شمارش متحرک
  var counters = document.querySelectorAll('[data-count]');
  function fmtNum(n, suffix) {
    var out;
    try { out = n.toLocaleString('fa-IR'); } catch (err) { out = String(n); }
    return out + (suffix || '');
  }
  function countUp(el) {
    var to = parseFloat(el.getAttribute('data-count'));
    var suffix = el.getAttribute('data-suffix') || '';
    if (reduce) { el.textContent = fmtNum(to, suffix); return; }
    var start = null;
    function step(ts) {
      if (start === null) start = ts;
      var t = Math.min((ts - start) / 1600, 1);
      var eased = 1 - Math.pow(1 - t, 3);
      el.textContent = fmtNum(Math.round(to * eased), suffix);
      if (t < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }
  if ('IntersectionObserver' in window && !reduce) {
    var cio = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (en.isIntersecting) { countUp(en.target); cio.unobserve(en.target); }
      });
    }, { threshold: 0.6 });
    counters.forEach(function (c) { cio.observe(c); });
  } else {
    counters.forEach(function (c) { countUp(c); });
  }

  // شبکه‌ی ذرات زنده در هیرو که به موس واکنش نشان می‌دهد
  var net = document.querySelector('.net');
  if (net && !reduce) {
    var heroEl = net.parentElement;
    var ctx = net.getContext('2d');
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var W = 0, H = 0, dots = [];
    var mouse = { x: -9999, y: -9999 };
    var inView = true;
    function sizeNet() {
      W = heroEl.offsetWidth;
      H = heroEl.offsetHeight;
      net.width = W * dpr;
      net.height = H * dpr;
      net.style.width = W + 'px';
      net.style.height = H + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      var n = Math.min(64, Math.floor(W * H / 15000));
      dots = [];
      for (var i = 0; i < n; i++) {
        dots.push({ x: Math.random() * W, y: Math.random() * H,
                    vx: (Math.random() - 0.5) * 0.4, vy: (Math.random() - 0.5) * 0.4 });
      }
    }
    sizeNet();
    window.addEventListener('resize', sizeNet);
    heroEl.addEventListener('pointermove', function (e) {
      var r = net.getBoundingClientRect();
      mouse.x = e.clientX - r.left;
      mouse.y = e.clientY - r.top;
    });
    heroEl.addEventListener('pointerleave', function () { mouse.x = -9999; mouse.y = -9999; });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (en) { inView = en[0].isIntersecting; }).observe(heroEl);
    }
    (function draw() {
      if (inView) {
        ctx.clearRect(0, 0, W, H);
        for (var i = 0; i < dots.length; i++) {
          var a = dots[i];
          a.x += a.vx; a.y += a.vy;
          if (a.x < 0 || a.x > W) a.vx *= -1;
          if (a.y < 0 || a.y > H) a.vy *= -1;
          ctx.fillStyle = 'rgba(246,220,159,.6)';
          ctx.beginPath();
          ctx.arc(a.x, a.y, 1.5, 0, Math.PI * 2);
          ctx.fill();
          for (var j = i + 1; j < dots.length; j++) {
            var b = dots[j];
            var dist = Math.hypot(a.x - b.x, a.y - b.y);
            if (dist < 130) {
              ctx.strokeStyle = 'rgba(212,175,106,' + ((1 - dist / 130) * 0.35) + ')';
              ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
            }
          }
          var md = Math.hypot(a.x - mouse.x, a.y - mouse.y);
          if (md < 170) {
            ctx.strokeStyle = 'rgba(246,220,159,' + ((1 - md / 170) * 0.7) + ')';
            ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(mouse.x, mouse.y); ctx.stroke();
          }
        }
      }
      requestAnimationFrame(draw);
    })();
  }

  // کلیک روی گوشی: مراحل تعمیر را یکی‌یکی نشان می‌دهد
  var deviceEl = document.querySelector('.device');
  var steps = document.querySelectorAll('.track li');
  var fillEl = document.querySelector('.fill');
  var stage = 2;
  deviceEl.addEventListener('click', function () {
    stage = (stage + 1) % steps.length;
    steps.forEach(function (li, i) {
      li.className = i < stage ? 'done' : (i === stage ? 'now' : '');
    });
    fillEl.style.animation = 'none';
    fillEl.style.width = (stage / (steps.length - 1) * 100) + '%';
  });

  if (!reduce && fine) {
    // نور نشانگر موس
    var glow = document.querySelector('.cursor-glow');
    var tx = -999, ty = -999, cx = -999, cy = -999;
    window.addEventListener('pointermove', function (e) { tx = e.clientX; ty = e.clientY; }, { passive: true });
    (function loop() {
      cx += (tx - cx) * 0.14;
      cy += (ty - cy) * 0.14;
      glow.style.transform = 'translate(' + (cx - 230) + 'px,' + (cy - 230) + 'px)';
      requestAnimationFrame(loop);
    })();

    // نورپردازی روی کارت‌ها
    document.addEventListener('pointermove', function (e) {
      var card = e.target.closest ? e.target.closest('.card') : null;
      if (!card) return;
      var r = card.getBoundingClientRect();
      card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
      card.style.setProperty('--my', (e.clientY - r.top) + 'px');
    });

    // جذب ملایم دکمه‌ها به سمت موس
    document.querySelectorAll('.btn, .wa-float').forEach(function (el) {
      el.addEventListener('pointermove', function (e) {
        var r = el.getBoundingClientRect();
        var x = (e.clientX - r.left - r.width / 2) * 0.22;
        var y = (e.clientY - r.top - r.height / 2) * 0.22;
        el.style.transform = 'translate(' + x + 'px,' + y + 'px)';
      });
      el.addEventListener('pointerleave', function () { el.style.transform = ''; });
    });

    // چرخش سه‌بعدی ملایم دستگاه با حرکت موس
    var hero = document.querySelector('.hero');
    var device = document.querySelector('.device');
    hero.addEventListener('pointermove', function (e) {
      var r = hero.getBoundingClientRect();
      var px = (e.clientX - r.left) / r.width - 0.5;
      var py = (e.clientY - r.top) / r.height - 0.5;
      device.style.transform = 'rotateY(' + (px * 14) + 'deg) rotateX(' + (-py * 10) + 'deg)';
    });
    hero.addEventListener('pointerleave', function () { device.style.transform = ''; });
  }
})();
</script>
