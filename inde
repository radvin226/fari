<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#07080b">
<meta name="description" content="تعمیرات تخصصی موبایل و پخش قطعات موبایل فرزاد؛ بررسی دستگاه، اعلام هزینه پیش از تعمیر و پاسخ‌گویی به مشتریان.">
<title>تعمیرات و پخش قطعات موبایل فرزاد</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ccircle cx='8' cy='8' r='8' fill='%23d4af6a'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#07080b;--bg2:#0c0e13;--surface:#11141a;
  --line:rgba(255,255,255,.07);--line2:rgba(255,255,255,.12);
  --gold:#d4af6a;--gold2:#f6dc9f;--text:#f2f2f4;--mute:#9ba1ad;
  --ok:#3fbf7f;--bad:#e26a6a;--radius:18px;
  --ease:cubic-bezier(.2,.7,.2,1);
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{scroll-behavior:smooth;scroll-padding-top:92px}
body{margin:0;font-family:Vazirmatn,Tahoma,sans-serif;background:var(--bg);color:var(--text);line-height:1.9;font-size:16px;-webkit-font-smoothing:antialiased;overflow-x:hidden}
h1,h2,h3,h4{margin:0;line-height:1.45;font-weight:700}
p{margin:0}
a{color:inherit}
:focus-visible{outline:2px solid var(--gold2);outline-offset:3px;border-radius:8px}
.container{max-width:1140px;margin:0 auto;padding:0 24px;position:relative}
section{padding:110px 0;position:relative}
.skip{position:absolute;inset-inline-start:16px;top:-60px;background:var(--gold);color:#15110a;padding:10px 16px;border-radius:10px;z-index:100;text-decoration:none;font-weight:700}
.skip:focus{top:12px}

/* پس‌زمینه‌ی متحرک */
body::before{content:"";position:fixed;inset:-20%;z-index:-2;pointer-events:none;
  background:radial-gradient(40% 40% at 72% 18%,rgba(212,175,106,.13),transparent 70%),
             radial-gradient(35% 35% at 18% 78%,rgba(246,220,159,.07),transparent 70%);
  animation:aurora 24s ease-in-out infinite alternate}
@keyframes aurora{from{transform:translate(0,0) scale(1)}to{transform:translate(-5%,4%) scale(1.06)}}
.cursor-glow{position:fixed;left:0;top:0;width:460px;height:460px;border-radius:50%;pointer-events:none;z-index:-1;background:radial-gradient(circle,rgba(212,175,106,.14),transparent 62%);will-change:transform}
@media (hover:none){.cursor-glow{display:none}}

/* نوار پیشرفت صفحه */
.progress{position:fixed;top:0;inset-inline-start:0;height:3px;width:0;z-index:70;background:linear-gradient(90deg,var(--gold),var(--gold2));box-shadow:0 0 14px rgba(212,175,106,.6)}

/* اجزای مشترک */
.ic{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}
.eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:.84rem;color:var(--gold2);padding:6px 14px;border:1px solid rgba(212,175,106,.25);border-radius:99px;background:rgba(212,175,106,.06);backdrop-filter:blur(6px)}
.eyebrow::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 0 rgba(212,175,106,.6);animation:dot 2.4s infinite}
@keyframes dot{0%{box-shadow:0 0 0 0 rgba(212,175,106,.6)}70%,100%{box-shadow:0 0 0 8px rgba(212,175,106,0)}}
.section-head{max-width:660px;margin-bottom:52px}
.section-head h2{font-size:clamp(1.7rem,3.2vw,2.4rem);margin:18px 0 12px}
.section-head p{color:var(--mute)}
.btn{position:relative;overflow:hidden;display:inline-flex;align-items:center;gap:8px;padding:13px 26px;border-radius:12px;border:0;cursor:pointer;font:inherit;font-weight:700;text-decoration:none;color:#15110a;background:linear-gradient(135deg,var(--gold),var(--gold2));transition:box-shadow .3s ease,transform .3s var(--ease)}
.btn::after{content:"";position:absolute;top:0;inset-inline-start:-80%;width:50%;height:100%;background:linear-gradient(120deg,transparent,rgba(255,255,255,.55),transparent);transform:skewX(-20deg)}
.btn:hover{box-shadow:0 14px 36px rgba(212,175,106,.3)}
.btn:hover::after{animation:sweep .9s var(--ease)}
@keyframes sweep{to{transform:translateX(-340%) skewX(-20deg)}}
.btn-ghost{background:rgba(255,255,255,.02);color:var(--text);border:1px solid var(--line2);backdrop-filter:blur(6px)}
.btn-ghost::after{display:none}
.btn-ghost:hover{border-color:var(--gold);color:var(--gold2);box-shadow:none}
.btn-sm{padding:9px 18px;font-size:.92rem;border-radius:10px}
.ic-arrow{transition:transform .3s var(--ease)}
.btn:hover .ic-arrow,.part-foot a:hover .ic-arrow{transform:translateX(-4px)}
.card{position:relative;overflow:hidden;background:linear-gradient(180deg,var(--surface),var(--bg2));border:1px solid var(--line);border-radius:var(--radius);padding:30px;transition:translate .4s var(--ease),border-color .3s,box-shadow .4s}
.card::before{content:"";position:absolute;inset:0;pointer-events:none;opacity:0;transition:opacity .4s;background:radial-gradient(340px circle at var(--mx,50%) var(--my,50%),rgba(212,175,106,.16),transparent 62%)}
.card:hover::before{opacity:1}
.card>*{position:relative}
.card:hover{translate:0 -6px;border-color:rgba(212,175,106,.35);box-shadow:0 24px 50px -24px rgba(0,0,0,.8)}
.card h3{font-size:1.12rem;margin-bottom:8px}
.card p{color:var(--mute);font-size:.95rem}
.icon-box{width:52px;height:52px;border-radius:15px;display:grid;place-items:center;background:rgba(212,175,106,.1);color:var(--gold2);margin-bottom:20px;transition:transform .5s var(--ease),background .3s}
.card:hover .icon-box{transform:rotate(-6deg) scale(1.1);background:rgba(212,175,106,.18)}

/* هدر */
.site-header{position:sticky;top:0;z-index:50;background:rgba(7,8,11,.7);backdrop-filter:saturate(1.5) blur(16px);-webkit-backdrop-filter:saturate(1.5) blur(16px);border-bottom:1px solid transparent;transition:border-color .3s,background .3s}
.site-header.scrolled{border-color:var(--line);background:rgba(7,8,11,.9)}
.bar{display:flex;align-items:center;gap:28px;height:76px;transition:height .3s var(--ease)}
.site-header.scrolled .bar{height:66px}
.logo{display:flex;align-items:center;gap:12px;text-decoration:none;font-weight:700;font-size:1.15rem}
.mark{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:linear-gradient(135deg,var(--gold),var(--gold2));color:#15110a;font-weight:700;font-size:1.12rem;box-shadow:0 0 0 0 rgba(212,175,106,.5);animation:markGlow 3.6s ease-in-out infinite}
@keyframes markGlow{0%,100%{box-shadow:0 0 0 0 rgba(212,175,106,.45)}50%{box-shadow:0 0 22px 2px rgba(212,175,106,.35)}}
.nav{display:flex;gap:28px;margin-inline-start:auto}
.nav a{position:relative;color:var(--mute);text-decoration:none;font-size:.95rem;transition:color .25s;padding:4px 0}
.nav a::after{content:"";position:absolute;bottom:-4px;inset-inline:0;height:2px;border-radius:2px;background:var(--gold);transform:scaleX(0);transition:transform .35s var(--ease)}
.nav a:hover{color:var(--text)}
.nav a:hover::after{transform:scaleX(1)}
.menu-btn{display:none;margin-inline-start:auto;width:44px;height:44px;border-radius:12px;border:1px solid var(--line2);background:transparent;cursor:pointer;flex-direction:column;align-items:center;justify-content:center;gap:5px}
.menu-btn span{display:block;width:18px;height:2px;border-radius:2px;background:var(--text);transition:transform .3s var(--ease),opacity .3s}
.site-header.open .menu-btn span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.site-header.open .menu-btn span:nth-child(2){opacity:0}
.site-header.open .menu-btn span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

/* هیرو */
.hero{padding:104px 0 96px;overflow:hidden}
.hero::before{content:"";position:absolute;inset:0;z-index:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:58px 58px;-webkit-mask-image:radial-gradient(ellipse at 62% 40%,#000 10%,transparent 70%);mask-image:radial-gradient(ellipse at 62% 40%,#000 10%,transparent 70%)}
.orb{position:absolute;border-radius:50%;filter:blur(70px);opacity:.32;pointer-events:none;z-index:0;animation:drift 16s ease-in-out infinite}
.orb.o1{width:380px;height:380px;background:var(--gold);top:-120px;inset-inline-start:-140px}
.orb.o2{width:300px;height:300px;background:#8a6a2c;bottom:-100px;inset-inline-end:10%;animation-duration:20s;animation-delay:-6s}
.orb.o3{width:200px;height:200px;background:var(--gold2);top:40%;inset-inline-start:42%;opacity:.18;animation-duration:13s;animation-delay:-3s}
@keyframes drift{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(50px,-36px) scale(1.1)}}
.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:64px;align-items:center;position:relative;z-index:1}
.hero h1{font-size:clamp(2.2rem,5vw,3.6rem);line-height:1.35;margin:22px 0;letter-spacing:-.01em}
.w{display:inline-block;opacity:0;animation:wordIn 1s var(--ease) both;animation-delay:calc(var(--i) * 110ms + 180ms)}
.w.g{background:linear-gradient(90deg,var(--gold),#fff3d1,var(--gold2),var(--gold));background-size:260% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:wordIn 1s var(--ease) both,shimmer 5.5s linear infinite;animation-delay:calc(var(--i) * 110ms + 180ms),0s}
@keyframes wordIn{from{opacity:0;transform:translateY(42px) rotate(3deg);filter:blur(6px)}to{opacity:1;transform:none;filter:none}}
@keyframes shimmer{from{background-position:120% center}to{background-position:-40% center}}
.lead{color:var(--mute);font-size:1.1rem;max-width:560px;margin-bottom:34px;animation:fadeUp 1s var(--ease) .75s both}
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
.cta{display:flex;gap:14px;flex-wrap:wrap;animation:fadeUp 1s var(--ease) .9s both}
.trust{list-style:none;margin:40px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:14px 28px;color:var(--mute);font-size:.95rem;animation:fadeUp 1s var(--ease) 1.05s both}
.trust li{display:flex;align-items:center;gap:8px}
.trust .ic{color:var(--ok);width:18px;height:18px}

.hero-visual{perspective:1100px;display:grid;place-items:center}
.float{animation:float 6.5s ease-in-out infinite}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-16px)}}
.device{width:300px;padding:12px;border-radius:46px;background:linear-gradient(160deg,#2a2e38,#0b0c10 60%,#1a1d25);border:1px solid #2f3440;box-shadow:0 50px 90px -30px rgba(0,0,0,.8),0 0 80px -20px rgba(212,175,106,.25);transition:transform .6s var(--ease);transform-style:preserve-3d}
.screen{background:#0b0d12;border-radius:36px;padding:26px 20px 30px;border:1px solid #1d2028;min-height:450px}
.screen-top{display:flex;justify-content:space-between;align-items:center;color:var(--mute);font-size:.86rem;margin-bottom:20px}
.badge{padding:3px 11px;border-radius:99px;background:#1a1d25;color:var(--gold2);font-size:.8rem}
.device-card{display:flex;align-items:center;gap:14px;padding:14px;margin-bottom:22px;border-radius:16px;background:var(--surface);border:1px solid var(--line)}
.device-ic{width:46px;height:46px;border-radius:13px;display:grid;place-items:center;background:rgba(212,175,106,.12);color:var(--gold2)}
.device-ic .ic{width:22px;height:22px}
.device-card strong{display:block;font-size:.98rem}
.device-card small{color:var(--mute);font-size:.84rem}
.bar-track{height:8px;border-radius:99px;background:#1c1f27;overflow:hidden;margin-bottom:24px}
.fill{display:block;height:100%;width:0;border-radius:inherit;background:linear-gradient(90deg,var(--gold),var(--gold2));box-shadow:0 0 16px rgba(212,175,106,.6);animation:fill 2s var(--ease) 1.1s forwards}
@keyframes fill{to{width:60%}}
.track{list-style:none;margin:0;padding:0}
.track li{position:relative;padding:0 28px 22px;color:var(--mute);font-size:.93rem;opacity:0;animation:rise .7s var(--ease) forwards;animation-delay:calc(var(--i) * 380ms + 900ms)}
@keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.track li::before{content:"";position:absolute;inset-inline-start:4px;top:7px;width:12px;height:12px;border-radius:50%;background:#262a33;border:2px solid #0b0d12}
.track li::after{content:"";position:absolute;inset-inline-start:9px;top:21px;bottom:-4px;width:2px;background:#262a33}
.track li:last-child{padding-bottom:0}
.track li:last-child::after{display:none}
.track .done{color:var(--text)}
.track .done::before{background:var(--ok)}
.track .done::after{background:var(--ok)}
.track .now{color:var(--gold2);font-weight:700}
.track .now::before{background:var(--gold);animation:pulse 2s ease-in-out infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 4px rgba(212,175,106,.22)}50%{box-shadow:0 0 0 10px rgba(212,175,106,.02)}}

/* نوار برندها */
.marquee{overflow:hidden;border-block:1px solid var(--line);padding:26px 0;-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
.marquee-track{display:flex;width:max-content;animation:marquee 26s linear infinite}
.mq-group{display:flex;gap:84px;padding-inline-start:84px;flex:none}
.mq-group span{font-weight:700;letter-spacing:.22em;font-size:1.05rem;color:#4f5563;transition:color .3s;white-space:nowrap}
.mq-group span:hover{color:var(--gold2)}
@keyframes marquee{to{transform:translateX(-50%)}}

/* گرید */
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}

/* قطعات */
.chips{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:34px}
.chip{padding:9px 20px;border-radius:99px;border:1px solid var(--line2);background:transparent;color:var(--mute);font:inherit;cursor:pointer;transition:all .3s var(--ease)}
.chip:hover{color:var(--text);border-color:var(--gold);transform:translateY(-2px)}
.chip[aria-pressed="true"]{background:var(--gold);border-color:var(--gold);color:#15110a;font-weight:700;box-shadow:0 8px 24px rgba(212,175,106,.3)}
.part{display:flex;flex-direction:column}
.part.is-off{opacity:.55}
.part-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
.logo-badge{width:48px;height:48px;border-radius:14px;display:grid;place-items:center;background:#1b1e27;border:1px solid var(--line2);color:var(--gold2);font-weight:700;transition:transform .5s var(--ease),border-color .3s}
.part:hover .logo-badge{transform:rotate(-8deg) scale(1.08);border-color:var(--gold)}
.status{display:inline-flex;align-items:center;gap:8px;font-size:.84rem;color:var(--mute)}
.status::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--ok);animation:live 2.2s infinite}
.status.off::before{background:var(--bad);animation:none}
@keyframes live{0%,100%{box-shadow:0 0 0 0 rgba(63,191,127,.55)}60%{box-shadow:0 0 0 7px rgba(63,191,127,0)}}
.part h3{font-size:1.05rem;margin-bottom:4px}
.part .meta{color:var(--mute);font-size:.9rem}
.part-foot{margin-top:auto;padding-top:20px;display:flex;justify-content:space-between;align-items:center;gap:12px;border-top:1px solid var(--line)}
.price{font-weight:700;color:var(--gold2)}
.part-foot a{font-size:.9rem;color:var(--mute);text-decoration:none;display:inline-flex;align-items:center;gap:6px;transition:color .3s}
.part-foot a:hover{color:var(--gold2)}
.part-foot a .ic{width:16px;height:16px}
.off-note{color:var(--mute);font-size:.9rem}

/* روند کار */
.timeline{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:26px;position:relative}
.timeline::before{content:"";position:absolute;top:30px;inset-inline:30px;height:2px;border-radius:2px;background:linear-gradient(90deg,var(--gold),rgba(212,175,106,.12));transform:scaleX(0);transform-origin:right center}
.timeline.in::before{animation:grow 1.6s var(--ease) .3s forwards}
@keyframes grow{to{transform:scaleX(1)}}
.step{position:relative}
.step .num{width:60px;height:60px;border-radius:50%;display:grid;place-items:center;background:var(--bg2);border:1px solid var(--gold);color:var(--gold2);font-weight:700;font-size:1.15rem;margin-bottom:22px;position:relative;z-index:1;transform:scale(.6);opacity:0}
.step.in .num{animation:pop .8s cubic-bezier(.34,1.56,.64,1) forwards;animation-delay:calc(var(--d,0ms) + 350ms)}
@keyframes pop{to{transform:scale(1);opacity:1}}
.step h3{font-size:1.08rem;margin-bottom:8px}
.step p{color:var(--mute);font-size:.94rem}

/* سوالات */
.faq{max-width:840px;display:grid;gap:14px}
details.faq-item{background:linear-gradient(180deg,var(--surface),var(--bg2));border:1px solid var(--line);border-radius:18px;padding:0 26px;transition:border-color .3s,box-shadow .3s}
details.faq-item[open]{border-color:rgba(212,175,106,.35);box-shadow:0 18px 40px -22px rgba(212,175,106,.35)}
details summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:22px 0;font-weight:700}
details summary::-webkit-details-marker{display:none}
details summary::after{content:"+";font-size:1.6rem;line-height:1;color:var(--gold2);font-weight:400;transition:transform .4s var(--ease)}
details[open] summary::after{transform:rotate(45deg)}
details p{padding:0 0 24px;color:var(--mute)}

/* ماموریت */
.band{border-radius:28px;padding:64px 44px;text-align:center;position:relative;overflow:hidden;background:linear-gradient(135deg,rgba(212,175,106,.16),rgba(212,175,106,.02));border:1px solid rgba(212,175,106,.22)}
.band::before{content:"";position:absolute;inset:-50%;background:conic-gradient(from 0deg,transparent,rgba(246,220,159,.12),transparent 40%);animation:spin 14s linear infinite;pointer-events:none}
@keyframes spin{to{transform:rotate(360deg)}}
.band p{position:relative;font-size:clamp(1.2rem,2.3vw,1.5rem);line-height:1.85;max-width:780px;margin:0 auto}

/* تماس */
.contact-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:22px}
.info{display:grid;gap:28px;padding:36px}
.info ul{list-style:none;margin:0;padding:0;display:grid;gap:26px}
.info li{display:flex;gap:16px;align-items:flex-start}
.info .icon-box{margin:0}
.info strong{display:block}
.info span{color:var(--mute);font-size:.95rem}
form.card{display:grid;gap:18px}
label{display:grid;gap:8px;color:var(--mute);font-size:.92rem}
input,textarea{width:100%;font:inherit;color:var(--text);background:#0a0c10;border:1px solid var(--line2);border-radius:12px;padding:13px 16px;transition:border-color .3s,box-shadow .3s}
input:focus,textarea:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 4px rgba(212,175,106,.14)}
textarea{min-height:120px;resize:vertical}
.form-note{color:var(--mute);font-size:.9rem;margin-top:6px}

/* پاورقی */
.site-footer{border-top:1px solid var(--line);padding:70px 0 34px;color:var(--mute);position:relative}
.foot-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:44px}
.foot-grid h4{color:var(--text);font-size:1rem;margin-bottom:16px}
.foot-grid ul{list-style:none;margin:0;padding:0;display:grid;gap:11px}
.foot-grid a{text-decoration:none;color:var(--mute);transition:color .3s}
.foot-grid a:hover{color:var(--gold2)}
.foot-about{max-width:360px}
.foot-about .logo{margin-bottom:16px}
.copy{margin-top:52px;padding-top:24px;border-top:1px solid var(--line);font-size:.88rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px}

/* واتساپ شناور */
.wa-float{position:fixed;bottom:24px;left:24px;z-index:40;display:inline-flex;align-items:center;gap:9px;padding:14px 22px;border-radius:99px;background:#25d366;color:#06150c;font-weight:700;text-decoration:none;box-shadow:0 14px 36px rgba(37,211,102,.35);transition:transform .3s var(--ease)}
.wa-float::before{content:"";position:absolute;inset:0;border-radius:inherit;border:2px solid #25d366;animation:ring 2.4s var(--ease) infinite;pointer-events:none}
@keyframes ring{from{transform:scale(1);opacity:.7}to{transform:scale(1.5);opacity:0}}

/* ورود اسکرولی */
.js .reveal{opacity:0}
.js .reveal.in{animation:rise .9s var(--ease) var(--d,0ms) both}

/* واکنش‌گرا */
@media (max-width:1000px){
  .grid-3{grid-template-columns:repeat(2,1fr)}
  .timeline{grid-template-columns:repeat(2,1fr);gap:40px}
  .timeline::before{display:none}
  .foot-grid{grid-template-columns:1fr 1fr}
  .foot-about{grid-column:1/-1;max-width:none}
}
@media (max-width:860px){
  .menu-btn{display:flex}
